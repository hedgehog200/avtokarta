<Window x:Class="AVTOKarta.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:AVTOKarta.Converters"
        xmlns:views="clr-namespace:AVTOKarta.Views"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xml:lang="ru-RU"
        Title="АВТОКарта v1.1.9 — WebARTup - Studio: Technologies" Height="750" Width="1150"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized"
        KeyDown="Window_KeyDown"
        Icon="app.ico"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
        <converters:DoubleStringConverter x:Key="DoubleStr"/>

        <!-- DataGrid: wrapping column headers so full header text is visible -->
        <Style x:Key="CardGridHeaderStyle" TargetType="DataGridColumnHeader"
               BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate>
                        <TextBlock Text="{Binding}" TextWrapping="Wrap" TextAlignment="Center"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid x:Name="RootGrid">
        <!-- Main layout: top bar + content -->
        <Grid.RowDefinitions>
            <RowDefinition Height="56"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- ===== TOP BAR ===== -->
        <Border Grid.Row="0" Background="{StaticResource TopBarBrush}"
                BorderBrush="{StaticResource TopBarBorderBrush}" BorderThickness="0,0,0,1"
                Padding="8,0,16,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Burger icon -->
                <Button Grid.Column="0" x:Name="BurgerBtn"
                        Style="{StaticResource BurgerButton}" Click="BurgerBtn_Click"
                        Margin="4,0,8,0">
                    <Path Data="M4,6 L20,6 M4,12 L20,12 M4,18 L20,18"
                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                          StrokeThickness="2" Stretch="Uniform" Width="18" Height="18"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"/>
                </Button>

                <!-- App title -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="АВТОКАРТА" FontSize="16" FontWeight="Bold"
                               Foreground="{StaticResource PrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="  |  " FontSize="14" Foreground="{StaticResource TextTertiaryBrush}"
                               VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SquadName}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding SquadNumber}" FontSize="14" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Right side: month/year + status -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentMonthYear}" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== CONTENT AREA ===== -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>
            <!-- DriverList -->
            <views:DriverListView DataContext="{Binding DriverListVm}"
                                  Visibility="{Binding DataContext.IsDriverListMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                  Panel.ZIndex="0"/>

            <!-- SquadSetup -->
            <views:SquadSetupView DataContext="{Binding SquadSetupVm}"
                                  Visibility="{Binding DataContext.IsSetupMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVis}}"
                                  Panel.ZIndex="1"/>

            <!-- SquadList -->
            <views:SquadListView DataContext="{Binding}"
                                  Visibility="{Binding IsSquadListMode, Converter={StaticResource BoolToVis}}"
                                  Panel.ZIndex="2"/>

            <!-- VehicleList -->
            <DockPanel Visibility="{Binding IsVehicleMode, Converter={StaticResource BoolToVis}}" Panel.ZIndex="3">
                <Border DockPanel.Dock="Top" Margin="16,12,16,8" Padding="16,12"
                        Style="{StaticResource CardBorderShadow}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <Border Width="38" Height="38" CornerRadius="10" Background="#10B981" Margin="0,0,12,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#x25CF;" FontSize="18" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <TextBlock Grid.Column="1" Text="Автомобили" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="2" Content="+ ДОБАВИТЬ"
                                Command="{Binding AddVehicleCommand}"
                                Style="{StaticResource SuccessButton}" Padding="14,7" FontSize="12"/>
                    </Grid>
                </Border>

                <Border Margin="16,0,16,8" Padding="12"
                        Style="{StaticResource CardBorderShadow}">
                    <DataGrid ItemsSource="{Binding Vehicles}"
                              SelectedItem="{Binding SelectedVehicle}"
                              CanUserAddRows="False" AutoGenerateColumns="False"
                              RowHeaderWidth="0" FontSize="12"
                              HeadersVisibility="Column" GridLinesVisibility="None"
                              BorderThickness="0" Background="Transparent"
                              AlternatingRowBackground="#FAFBFC">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ГОС. ЗНАК" Binding="{Binding LicensePlate}" Width="100" IsReadOnly="True"/>
                            <DataGridTextColumn Header="МАРКА" Binding="{Binding Make}" Width="140" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ТИП" Binding="{Binding Type}" Width="130" IsReadOnly="True"/>
                            <DataGridTextColumn Header="ДВИГАТЕЛЬ" Binding="{Binding EngineDisplay}" Width="80" IsReadOnly="True"/>
                            <DataGridTextColumn Header="№ КАРТОЧКИ" Binding="{Binding CardNumber}" Width="90" IsReadOnly="True"/>
                             <DataGridTextColumn Header="ПРОБЕГ ШАССИ" Binding="{Binding InitialChassisMileage, StringFormat=F3}" Width="100" IsReadOnly="True"/>
                             <DataGridTextColumn Header="ПРОБЕГ ДВИГ." Binding="{Binding InitialEngineMileage, StringFormat=F3}" Width="100" IsReadOnly="True"/>
                            <DataGridTemplateColumn Header="" Width="70" IsReadOnly="True">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="&#x270E;" Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.EditVehicleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" FontSize="13" Padding="5"
                                                    Foreground="{StaticResource PrimaryBrush}"/>
                                            <Button Content="&#x2716;" Style="{StaticResource IconButton}"
                                                    Command="{Binding DataContext.DeleteVehicleCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" FontSize="11" Padding="5"
                                                    Foreground="{StaticResource DangerBrush}"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>
            </DockPanel>

            <!-- Card screen -->
            <DockPanel Visibility="{Binding IsCardMode, Converter={StaticResource BoolToVis}}" Panel.ZIndex="4">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,16,16">
                        <Border Margin="16,12,16,0" Padding="16,12"
                                Style="{StaticResource CardBorderShadow}">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontSize="16" FontWeight="Bold" VerticalAlignment="Center">
                                        <Run Text="ЭКСПЛУАТАЦИОННАЯ КАРТОЧКА"/>
                                    </TextBlock>

                                    <TextBlock Grid.Column="1" Text="Месяц:" VerticalAlignment="Center"
                                               Margin="16,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <ComboBox Grid.Column="2" ItemsSource="{Binding MonthNames}"
                                              SelectedIndex="{Binding SelectedMonthIndex}"
                                              Width="130" Margin="0,0,12,0"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                                    <TextBlock Grid.Column="3" Text="Год:" VerticalAlignment="Center"
                                               Margin="0,0,4,0" Foreground="{StaticResource TextSecondaryBrush}"/>
                                    <TextBox Grid.Column="4" Text="{Binding SelectedYear, UpdateSourceTrigger=PropertyChanged}"
                                             Width="60"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                    <TextBlock Text="Авто:" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,6,0"/>
                                    <ComboBox FontSize="12"
                                              ItemsSource="{Binding Vehicles}"
                                              SelectedItem="{Binding CardVehicle}"
                                              Width="180" HorizontalAlignment="Left"
                                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding CardNumber}" FontWeight="SemiBold"/>
                                                    <TextBlock FontSize="10" Foreground="{StaticResource TextSecondaryBrush}">
                                                        <Run Text="{Binding Make, Mode=OneWay}"/>
                                                        <Run Text=" | "/>
                                                        <Run Text="{Binding LicensePlate, Mode=OneWay}"/>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <TextBlock Margin="0,4,0,0" FontSize="12"
                                           Foreground="{StaticResource TextSecondaryBrush}">
                                    <Run Text="Марка: "/><Run Text="{Binding SelectedVehicleMake, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="   Тип: "/><Run Text="{Binding SelectedVehicleType, Mode=OneWay}" FontWeight="SemiBold"/>
                                </TextBlock>
                            </StackPanel>
                        </Border>

                        <Border Margin="16,8,16,0" Padding="16"
                                Style="{StaticResource CardBorderShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                    <RowDefinition/>
                                </Grid.RowDefinitions>

                                <Label Grid.Row="0" Grid.Column="0" Content="Пробег шасси на 1-е:"/>
                                <TextBox Grid.Row="0" Grid.Column="1"
                                         Text="{Binding CurrentCard.ChassisMileageOnFirst, Converter={StaticResource DoubleStr}}" Margin="2,4"
                                         IsReadOnly="True" Background="{StaticResource PrimaryLightBrush}"/>
                                <Label Grid.Row="0" Grid.Column="2" Content="Приведённый пробег:"/>
                                <TextBox Grid.Row="0" Grid.Column="3"
                                         Text="{Binding ReducedMileage, Converter={StaticResource DoubleStr}}" Margin="2,4"
                                         IsReadOnly="True" Background="{StaticResource PrimaryLightBrush}"/>

                                <Label Grid.Row="1" Grid.Column="0" Content="Остаток топлива на 1-е:"/>
                                <TextBox Grid.Row="1" Grid.Column="1"
                                         Text="{Binding CurrentCard.FuelRemainingOnFirst, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DoubleStr}}" Margin="2,4"/>
                                <Label Grid.Row="1" Grid.Column="2" Content="Заправлено за месяц (приход):"/>
                                <TextBox Grid.Row="1" Grid.Column="3"
                                         Text="{Binding CurrentCard.FuelRefueledMonth, Converter={StaticResource DoubleStr}}" Margin="2,4"
                                         IsReadOnly="True" Background="{StaticResource PrimaryLightBrush}"/>

                                <Label Grid.Row="2" Grid.Column="0" Content="Расход топлива за месяц:"/>
                                <TextBox Grid.Row="2" Grid.Column="1" IsReadOnly="True"
                                         Text="{Binding TotalActual, Converter={StaticResource DoubleStr}}" Margin="2,4"
                                         Background="{StaticResource PrimaryLightBrush}"/>
                                <Label Grid.Row="2" Grid.Column="2" Content="Остаток на конец:"/>
                                <TextBox Grid.Row="2" Grid.Column="3" IsReadOnly="True"
                                         Text="{Binding CurrentCard.FuelRemainingOnLast, Converter={StaticResource DoubleStr}}" Margin="2,4"
                                         Background="{StaticResource PrimaryLightBrush}"/>

                                <Label Grid.Row="3" Grid.Column="0" Content="Уровень топлива (см):"/>
                                <TextBox Grid.Row="3" Grid.Column="1"
                                         Text="{Binding CurrentCard.FuelLevelCm, UpdateSourceTrigger=PropertyChanged, Converter={StaticResource DoubleStr}}" Margin="2,4"/>
                                <Label Grid.Row="3" Grid.Column="2" Content="Способ поступления:"/>
                                <ComboBox Grid.Row="3" Grid.Column="3"
                                          SelectedIndex="{Binding DeliveryTypeIndex, Mode=TwoWay}"
                                          Margin="2,4" MinWidth="200">
                                    <ComboBoxItem Content="централизованно"/>
                                    <ComboBoxItem Content="по расчёту своего РЦ"/>
                                    <ComboBoxItem Content="по расчёту других РЦ"/>
                                    <ComboBoxItem Content="закуплено на местах"/>
                                    <ComboBoxItem Content="прочий приход"/>
                                </ComboBox>
                            </Grid>
                        </Border>

                        <Border Margin="16,8,16,0" Padding="12"
                                Style="{StaticResource CardBorderShadow}">
<DataGrid ItemsSource="{Binding Records}"
                                              SelectedItem="{Binding SelectedRecord}"
                                              CanUserAddRows="False"
                                              FontSize="11" RowHeaderWidth="0"
                                              AutoGenerateColumns="False"
                                              EnableRowVirtualization="True"
                                              VirtualizingPanel.IsVirtualizing="True"
                                              VirtualizingPanel.VirtualizationMode="Recycling"
                                              MinHeight="220"
                                              ColumnHeaderStyle="{StaticResource CardGridHeaderStyle}"
                                              ScrollViewer.VerticalScrollBarVisibility="Auto"
                                              ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                              CanUserResizeRows="True">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Header="№ пут. листа" Width="75" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding TripSheetNumber}" TextWrapping="Wrap"
                                                           FontSize="11" Padding="2" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=d.M.yyyy}" Width="80" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Наименование и место работы автомобиля" Width="250" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding WorkDescription}" TextWrapping="Wrap"
                                                           FontSize="11" Padding="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Примечание" Width="180" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding Comments}" TextWrapping="Wrap"
                                                           FontSize="11" Padding="2"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn Header="Выезд" Binding="{Binding DepartureTimeDisplay}" Width="55" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Возврат" Binding="{Binding ReturnTimeDisplay}" Width="55" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Спидометр, км" Binding="{Binding OdometerBeforeDeparture, StringFormat=F3}" Width="80" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Пробег км" Binding="{Binding DistanceKm, StringFormat=F3}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="С насосом" Binding="{Binding TimeWithPumpMinutes, StringFormat=F3}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="На холостом (мин)" Binding="{Binding TimeWithoutPumpMinutes, StringFormat=F3}" Width="70" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Смена, мин." Binding="{Binding ShiftChangeMinutes, StringFormat=F3}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Прочие (мин)" Binding="{Binding MiscWorkMinutes, StringFormat=F3}" Width="60" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Приход (заправка)" Binding="{Binding FuelRefueled, StringFormat=F3}" Width="80" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="Расход (факт)" Binding="{Binding ActualConsumption, StringFormat=F3}" Width="80" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="По норме" Binding="{Binding NormConsumption, StringFormat=F3}" Width="60" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="Дежурный караул" Width="90" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding SquadNumber}" TextWrapping="Wrap"
                                                           FontSize="11" Padding="2" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn Header="Водитель" Width="150" IsReadOnly="True">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <TextBlock Text="{Binding DriverName}" TextWrapping="Wrap"
                                                           FontSize="11" Padding="2" VerticalAlignment="Center"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Border>

                        <Border Margin="16,8,16,0" Padding="16"
                                Style="{StaticResource CardBorderShadow}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto"/>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0" Orientation="Horizontal">
                                    <Button Content="+ Добавить запись" Command="{Binding AddRecordCommand}"
                                            Style="{StaticResource SuccessButton}" Padding="12,7" Margin="0,0,4,0"/>
                                    <Button Content="Редактировать" Command="{Binding EditRecordCommand}"
                                            Padding="12,7" Margin="4,0"/>
                                    <Button Content="Удалить" Command="{Binding DeleteRecordCommand}"
                                            Style="{StaticResource DangerButton}" Padding="12,7" Margin="4,0,0,0"/>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal">
                                    <Button Content="Сохранить" Command="{Binding SaveCardCommand}"
                                            Style="{StaticResource SuccessButton}" Padding="12,7"/>
                                    <Button Content="Экспорт в Excel" Command="{Binding ExportExcelCommand}"
                                            Padding="12,7"/>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <Border Margin="16,8,16,0" Padding="16"
                                Style="{StaticResource CardBorderShadow}">
                            <DockPanel MaxHeight="150">
                                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,4">
                                    <TextBlock Text="История карточек" FontSize="12" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center"/>
                                    <Button Content="Открыть" Command="{Binding OpenHistoryCardCommand}"
                                            Padding="10,4" FontSize="11" Margin="8,0,0,0"/>
                                </StackPanel>
                                <ListBox ItemsSource="{Binding CardHistory}"
                                         SelectedItem="{Binding SelectedCardHistoryItem}"
                                         BorderThickness="0" Background="Transparent"
                                         DisplayMemberPath="MonthYearDisplay"/>
                            </DockPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </DockPanel>

            <!-- Settings -->
            <views:SettingsView DataContext="{Binding}"
                                Visibility="{Binding IsSettingsMode, Converter={StaticResource BoolToVis}}"
                                Panel.ZIndex="5"/>

            <!-- FuelReport -->
            <views:FuelReportView DataContext="{Binding}"
                                  Visibility="{Binding IsFuelReportMode, Converter={StaticResource BoolToVis}}"
                                  Panel.ZIndex="6"/>

            <!-- Warehouse -->
            <views:WarehouseView DataContext="{Binding}"
                                 Visibility="{Binding IsWarehouseMode, Converter={StaticResource BoolToVis}}"
                                 Panel.ZIndex="7"/>
        </Grid>

        <!-- ===== STATUS BAR ===== -->
        <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource DividerBrush}"
                BorderThickness="0,1,0,0" Padding="16,8"
                Visibility="{Binding IsDriverListMode, Converter={StaticResource BoolToVis}, ConverterParameter='Invert'}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" FontSize="11"
                           Foreground="{StaticResource TextSecondaryBrush}" VerticalAlignment="Center">
                    <Run Text="WebARTup - Studio: Technologies" FontSize="10" Foreground="{StaticResource TextTertiaryBrush}"/>
                    <Run Text="   |   "/>
                    <Run Text="{Binding StatusMessage, Mode=OneWay}"/>
                </TextBlock>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Visibility="{Binding IsCardMode, Converter={StaticResource BoolToVis}}">
                    <Border Background="{StaticResource PillSuccessBrush}" CornerRadius="12" Padding="12,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Факт: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding TotalActual, StringFormat=F3}" FontWeight="Bold" FontSize="12"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text=" л" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PillPrimaryBrush}" CornerRadius="12" Padding="12,5" Margin="0,0,6,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Норма: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding TotalNorm, StringFormat=F3}" FontWeight="Bold" FontSize="12"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text=" л" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PillSuccessBrush}" CornerRadius="12" Padding="12,5" Margin="0,0,6,0"
                            Visibility="{Binding SavingsVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Экономия: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding Savings, StringFormat=F3}" FontWeight="Bold" FontSize="12"
                                       Foreground="{StaticResource SuccessBrush}"/>
                            <TextBlock Text=" л" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{StaticResource PillWarningBrush}" CornerRadius="12" Padding="12,5"
                            Visibility="{Binding OverspendVisibility}">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Перерасход: " Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                            <TextBlock Text="{Binding Overspend, StringFormat=F3}" FontWeight="Bold" FontSize="12"
                                       Foreground="{StaticResource DangerBrush}"/>
                            <TextBlock Text=" л" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== BURGER MENU OVERLAY ===== -->
        <Grid x:Name="BurgerOverlay" Visibility="Collapsed" Panel.ZIndex="100" Grid.RowSpan="3">
            <!-- Dim backdrop -->
            <Border x:Name="OverlayBackdrop" Background="#600F172A" MouseLeftButtonDown="OverlayBackdrop_Click"/>
            <!-- Drawer panel from left -->
            <Border x:Name="DrawerPanel" Width="280" HorizontalAlignment="Left"
                    Background="{StaticResource DrawerBrush}"
                    BorderBrush="{StaticResource DrawerDividerBrush}" BorderThickness="0,0,1,0">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Opacity="0.15" Color="#000000" Direction="90"/>
                </Border.Effect>
                <DockPanel>
                    <!-- Drawer header -->
                    <Border DockPanel.Dock="Top" Padding="20,16,16,12">
                        <StackPanel>
                            <TextBlock Text="АВТОКАРТА" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource PrimaryBrush}"/>
                            <TextBlock Text="Система учёта ГСМ" FontSize="11"
                                       Foreground="{StaticResource DrawerLabelBrush}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DrawerDividerBrush}" Margin="16,0"/>

                    <!-- Squad selector -->
                    <Border DockPanel.Dock="Top" Padding="16,12">
                        <StackPanel>
                            <TextBlock Text="Текущая часть:" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource DrawerLabelBrush}" Margin="0,0,0,6"/>
                            <ComboBox ItemsSource="{Binding Squads}"
                                      SelectedItem="{Binding SelectedSquad}"
                                      Style="{StaticResource DrawerComboBox}"
                                      ItemContainerStyle="{StaticResource ComboBoxItemStyle}">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="{Binding Name}" Foreground="{StaticResource TextPrimaryBrush}" FontWeight="SemiBold"/>
                                            <TextBlock Text="{Binding Number}" Foreground="{StaticResource TextSecondaryBrush}" Margin="6,0,0,0"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border DockPanel.Dock="Top" Height="1" Background="{StaticResource DrawerDividerBrush}" Margin="16,0"/>

                    <!-- Squad info -->
                    <Border DockPanel.Dock="Bottom" Background="{StaticResource DrawerInfoBrush}" Margin="12,8,12,12" Padding="16,12"
                            CornerRadius="12">
                        <StackPanel>
                            <TextBlock Text="{Binding SquadName}" Foreground="{StaticResource TextPrimaryBrush}" FontSize="13"
                                       FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="{Binding SquadNumber}" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                                       Margin="0,2,0,0"/>
                        </StackPanel>
                    </Border>

                    <!-- Navigation -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="НАВИГАЦИЯ" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource DrawerLabelBrush}"
                                       Margin="20,8,20,6"/>

                            <Button Command="{Binding SquadListCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,21 V8 L12,2 L21,8 V21 H15 V14 H9 V21 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Части" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding DriverListCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,4 A4,4 0 1,1 12.001,4 M8,22 C8,18.686 9.79,16 12,16 C14.21,16 16,18.686 16,22"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Водители" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding VehicleListCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M3,17 V13 L5,9 H19 L21,13 V17 M7,20 A1.5,1.5 0 1,0 7.001,20 M17,20 A1.5,1.5 0 1,0 17.001,20 M5,17 H19"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Автомобили" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding CardListCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9,3 H15 V6 H9 Z M7,7 H17 V21 H7 Z M10,11 H14 M10,15 H14"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Карточки" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding WarehouseCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,3 C12,3 6,11 6,15 C6,18.3 8.7,21 12,21 C15.3,21 18,18.3 18,15 C18,11 12,3 12,3 Z"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Склад ГСМ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding SettingsCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,15 A3,3 0 1,1 12,9 A3,3 0 1,1 12,15 M12,2 V5 M22,12 H19 M12,22 V19 M2,12 H5 M19,5 L17,7 M17,17 L19,19 M7,17 L5,19 M5,7 L7,5"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Настройки" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding FuelReportCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M4,22 V14 M9,22 V8 M14,22 V11 M19,22 V5 M2,22 H22"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Отчёт ГСМ" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="{StaticResource DrawerDividerBrush}" Margin="16,8"/>

                            <TextBlock Text="ДАННЫЕ" FontSize="10" FontWeight="Bold"
                                       Foreground="{StaticResource DrawerLabelBrush}"
                                       Margin="20,8,20,6"/>

                            <Button Command="{Binding ExportDataCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,3 V15 M8,7 L12,3 L16,7 M4,17 V21 H20 V17"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Выгрузка данных" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Button Command="{Binding ImportDataCommand}" Style="{StaticResource DrawerNavButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M12,15 V3 M8,11 L12,15 L16,11 M4,21 V17 H20 V21"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Загрузка данных" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>

                            <Border Height="1" Background="{StaticResource DrawerDividerBrush}" Margin="16,8"/>

                            <Button Click="MenuItem_Exit_Click" Style="{StaticResource DrawerExitButton}">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="M9,3 H5 A2,2 0 0,0 3,5 V19 A2,2 0 0,0 5,21 H9 M15,16 L21,12 L15,8 M21,12 H9"
                                          Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"
                                          StrokeThickness="1.5" Stretch="Uniform" Width="18" Height="18"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                          Margin="0,0,12,0" VerticalAlignment="Center"/>
                                    <TextBlock Text="Выход" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
