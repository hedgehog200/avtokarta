<UserControl x:Class="AVTOKarta.Views.SquadSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:helpers="clr-namespace:AVTOKarta.Helpers"
             xml:lang="ru-RU">
    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#000000" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid MaxWidth="600" HorizontalAlignment="Center" Margin="0,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- ============ HEADER ============ -->
            <Border Grid.Row="0" Style="{StaticResource CardBorderShadow}" Margin="0,0,0,10" Padding="20,16">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                                Background="{StaticResource PrimaryLightBrush}" Margin="0,0,14,0"
                                VerticalAlignment="Center">
                            <TextBlock Text="&#x2699;" FontSize="20" Foreground="{StaticResource PrimaryBrush}"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock Text="Настройка части" FontSize="18" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}"/>
                            <TextBlock Text="Первоначальная настройка пожарной части и защитация данных"
                                       FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ PART DATA ============ -->
            <Border Grid.Row="1" Style="{StaticResource FieldCard}" Margin="0,0,0,10" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="ДАННЫЕ ЧАСТИ" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование части" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Номер части" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Номер отряда" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding CrewNumber, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Область / регион" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Адрес расположения" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="20"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Начальник части" Style="{StaticResource FormLabel}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="1" Text="{Binding ChiefName, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
                        <TextBlock Grid.Column="3" Text="Ст. водитель" Style="{StaticResource FormLabel}" Margin="0,0,8,0"/>
                        <TextBox Grid.Column="4" Text="{Binding SeniorDriverName, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center" HorizontalAlignment="Stretch"/>
                    </Grid>

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Телефон" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Column="1" Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"
                                 helpers:PhoneHelper.EnablePhoneFormat="True" MaxLength="18"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- ============ SECURITY ============ -->
            <Border Grid.Row="2" Style="{StaticResource FieldCard}" Margin="0,0,0,10" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="ЗАЩИТА ДАННЫХ" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,10"/>

                    <TextBlock Text="Пароль шифрования:" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                    <hc:PasswordBox x:Name="PasswordBox1" Height="36" Margin="0,0,0,10"
                                    Padding="10,7" FontSize="13"/>

                    <TextBlock Text="Подтвердите пароль:" Style="{StaticResource FormLabel}" Margin="0,0,0,4"/>
                    <hc:PasswordBox x:Name="PasswordBox2" Height="36"
                                    Padding="10,7" FontSize="13"/>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="SemiBold" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- ============ BUTTONS ============ -->
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,6,0,0">
                <Button Content="Отмена" Command="{Binding CancelCommand}"
                        Margin="0,0,8,0" FontSize="13" MinWidth="0" Padding="16,8"
                        Style="{StaticResource DangerButton}"/>
                <Button Content="Сохранить" Click="SaveButton_Click"
                        Margin="4" FontSize="13" MinWidth="0" Padding="16,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{StaticResource SuccessBrush}"
                                    CornerRadius="8" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#2E7D32"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</UserControl>
