<Window x:Class="AVTOKarta.Views.LicenseView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Активация программы" Height="560" Width="560"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}">
    <Border Background="White">
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="Hand">
                <DockPanel>
                    <TextBlock Text="&#xF2F9;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="16"
                               VerticalAlignment="Center" Margin="0,0,10,0" Foreground="White"/>
                    <TextBlock Text="Активация программы" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button Content="&#xF00D;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="12"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseBtn_Click" Width="32" Height="32"/>
                </DockPanel>
            </Border>

            <!-- Buttons -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="ExitButton" Content="Выход" Click="ExitButton_Click" MinWidth="110" MinHeight="40"
                            Margin="0,0,8,0" Style="{StaticResource GhostButton}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button x:Name="ActivateButton" Content="Активировать" Click="ActivateButton_Click" MinWidth="140" MinHeight="40"
                            Style="{StaticResource PrimaryButton}"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel Margin="24,20">
                    <TextBlock x:Name="TitleText" Text="Для работы программы требуется лицензия."
                               FontWeight="SemiBold" FontSize="14" TextWrapping="Wrap" Margin="0,0,0,6"/>
                    <TextBlock x:Name="ReasonText" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <TextBlock Text="Код этого компьютера:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <Grid Margin="0,0,0,6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="MachineCodeBox" Grid.Column="0" MinHeight="40" MinWidth="0" FontSize="16" FontFamily="Consolas"
                                 FontWeight="Bold" Padding="14,8" TextAlignment="Center" IsReadOnly="True"
                                 HorizontalAlignment="Left"
                                 VerticalContentAlignment="Center"/>
                        <Button Grid.Column="1" Content="Копировать" Click="CopyButton_Click" MinWidth="104"
                                MinHeight="40" Margin="8,0,0,0" Style="{StaticResource GhostButton}"
                                Foreground="{StaticResource PrimaryBrush}"/>
                    </Grid>
                    <TextBlock x:Name="MachineHintText" Text="Отправьте этот код производителю, чтобы получить файл лицензии (.lic)."
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"
                               TextWrapping="Wrap" Margin="0,0,0,18"/>

                    <TextBlock Text="Файл лицензии:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox x:Name="LicenseFileBox" MinHeight="40" Padding="12,8" Margin="0,0,0,8" IsReadOnly="True"/>

                    <Button Content="Выбрать файл лицензии (.lic)" Click="BrowseButton_Click" MinWidth="220" MinHeight="40"
                            HorizontalAlignment="Left" Margin="0,0,0,6" Style="{StaticResource GhostButton}"
                            Foreground="{StaticResource PrimaryBrush}"/>

                    <Border x:Name="InfoPanel" Margin="0,14,0,0" Padding="12,10" CornerRadius="10"
                            BorderThickness="1" BorderBrush="{StaticResource DividerBrush}"
                            Background="{StaticResource SurfaceBrush}">
                        <StackPanel>
                            <TextBlock x:Name="InfoTitleText" Text="Сведения о лицензии:" FontWeight="SemiBold" FontSize="12"
                                       Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4"
                                       Visibility="Collapsed"/>
                            <TextBlock x:Name="StatusText" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource DangerBrush}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>