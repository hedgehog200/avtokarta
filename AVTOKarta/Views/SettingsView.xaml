<UserControl x:Class="AVTOKarta.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:local="clr-namespace:AVTOKarta.Converters"
             xmlns:helpers="clr-namespace:AVTOKarta.Helpers"
             xml:lang="ru-RU">
    <UserControl.Resources>
        <Style x:Key="FormLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style x:Key="FieldCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DividerBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" ShadowDepth="1" Opacity="0.06" Color="#000000" Direction="270"/>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <DockPanel MaxWidth="600" HorizontalAlignment="Center" Margin="0,16">
            <!-- ============ HEADER ============ -->
            <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderShadow}" Margin="0,0,0,10" Padding="20,16">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                            Background="{StaticResource PrimaryLightBrush}" Margin="0,0,14,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="&#x2699;" FontSize="20" Foreground="{StaticResource PrimaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Настройки" FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                        <TextBlock Text="Настройки текущей пожарной части и обновление приложения"
                                   FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ============ PART SETTINGS ============ -->
            <Border DockPanel.Dock="Top" Style="{StaticResource FieldCard}" Margin="0,0,0,10" Padding="20,16">
                <StackPanel>
                    <TextBlock Text="НАСТРОЙКИ ЧАСТИ" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,10"/>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="10"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Наименование" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding SelectedSquad.Name, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Номер" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding SelectedSquad.Number, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Область / регион" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding SelectedSquad.Region, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="6" Grid.Column="0" Text="Начальник" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding SelectedSquad.ChiefName, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="8" Grid.Column="0" Text="Ст. водитель" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding SelectedSquad.SeniorDriverName, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>

                        <TextBlock Grid.Row="10" Grid.Column="0" Text="Телефон" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="10" Grid.Column="1" Text="{Binding SelectedSquad.Phone, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"
                                 helpers:PhoneHelper.EnablePhoneFormat="True" MaxLength="18"/>

                        <TextBlock Grid.Row="12" Grid.Column="0" Text="Адрес" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBox Grid.Row="12" Grid.Column="1" Text="{Binding SelectedSquad.Address, UpdateSourceTrigger=PropertyChanged}"
                                 MinHeight="32" Padding="10,7" FontSize="13"
                                 Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource DividerBrush}"
                                 BorderThickness="1" VerticalContentAlignment="Center"/>
                    </Grid>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                        <Button Content="Сохранить настройки" Command="{Binding SaveSettingsCommand}"
                                Style="{StaticResource SuccessButton}" Padding="14,8" Margin="0,0,8,0"/>
                        <Button Content="Сменить пароль" Command="{Binding ChangePasswordCommand}"
                                Padding="14,8"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- ============ INFO ============ -->
            <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="0,0,0,10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="Информация" FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                    <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                        Данные хранятся в зашифрованном виде в:
                        %LocalAppData%\AVTOKarta\Data\
                    </TextBlock>
                    <TextBlock Text="Шифрование: AES-256 (CBC, PKCS7)" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- ============ UPDATE SECTION ============ -->
            <Border DockPanel.Dock="Top" Style="{StaticResource FieldCard}" Margin="0,0,0,10" Padding="20,16">
                <StackPanel DataContext="{Binding UpdateVM}">
                    <TextBlock Text="ОБНОВЛЕНИЕ ПРИЛОЖЕНИЯ" FontSize="10" FontWeight="Bold"
                               Foreground="{StaticResource TextTertiaryBrush}" Margin="0,0,0,10"/>

                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Текущая версия:" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" FontWeight="Bold" FontSize="13"
                                   VerticalAlignment="Center"/>
                    </Grid>

                    <Grid Margin="0,0,0,8"
                          Visibility="{Binding RemoteVersion, Converter={x:Static local:NullOrEmptyToVisibilityConverter.Instance}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Версия на сервере:" Style="{StaticResource FormLabel}" Margin="0,0,10,0"/>
                        <TextBlock Grid.Column="1" Text="{Binding RemoteVersion}" FontWeight="Bold" FontSize="13"
                                   Foreground="{StaticResource SuccessBrush}" VerticalAlignment="Center"/>
                    </Grid>

                    <TextBlock Text="{Binding StatusText}" Margin="0,0,0,8" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8"
                                Visibility="{Binding IsDownloading, Converter={x:Static local:BoolToVisibilityConverter.Instance}}">
                        <ProgressBar Value="{Binding DownloadProgress}" Maximum="100"
                                     Width="200" Height="6" Margin="0,0,8,0" VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DownloadProgressText}" VerticalAlignment="Center" FontSize="12"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Проверить обновления" Command="{Binding CheckUpdateCommand}"
                                Padding="14,8" Margin="0,0,8,0"
                                IsEnabled="{Binding CanCheck}"/>
                        <Button Content="Скачать и установить" Command="{Binding DownloadUpdateCommand}"
                                Padding="14,8" Visibility="{Binding HasUpdate, Converter={x:Static local:BoolToVisibilityConverter.Instance}}"
                                Style="{StaticResource SuccessButton}"
                                IsEnabled="{Binding CanCheck}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding PublishedAt}" Margin="0,0,0,4" FontSize="12"
                               Foreground="{StaticResource TextSecondaryBrush}"/>

                    <Grid MaxHeight="150" Margin="0,0,0,4"
                          Visibility="{Binding ReleaseNotes, Converter={x:Static local:NullOrEmptyToVisibilityConverter.Instance}}">
                        <Grid.RowDefinitions>
                            <RowDefinition MaxHeight="150"/>
                        </Grid.RowDefinitions>
                        <Border Grid.Row="0" BorderThickness="1" BorderBrush="{StaticResource DividerBrush}">
                            <FlowDocumentScrollViewer Document="{Binding ReleaseNotesDocument}"
                                                       VerticalScrollBarVisibility="Auto"/>
                        </Border>
                    </Grid>
                </StackPanel>
            </Border>
        </DockPanel>
    </ScrollViewer>
</UserControl>
