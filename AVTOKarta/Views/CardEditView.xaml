<Window x:Class="AVTOKarta.Views.CardEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:AVTOKarta.Converters"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        xml:lang="ru-RU"
        Title="Ежедневная запись" Height="900" Width="580"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <conv:IntStringConverter x:Key="IntStr"/>
        <conv:DoubleStringConverter x:Key="DoubleStr"/>
        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Foreground" Value="{StaticResource PrimaryBrush}"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>
        <Style x:Key="TimeInput" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Center"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinWidth" Value="50"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="ReadOnlyField" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True"/>
            <Setter Property="Background" Value="{StaticResource PrimaryLightBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextSecondaryBrush}"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0"/>
            <Setter Property="MinHeight" Value="38"/>
            <Setter Property="FontSize" Value="14"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
    </Window.Resources>

    <DockPanel Background="White">
        <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14"
                MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="Hand">
            <DockPanel>
                <TextBlock Text="Ежедневная запись" FontSize="16" FontWeight="Bold" Foreground="White" VerticalAlignment="Center"/>
                <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                        HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                        BorderThickness="0" Cursor="Hand" Click="CloseBtn_Click" Width="32" Height="32"/>
            </DockPanel>
        </Border>

        <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="20,16">
            <StackPanel>
                <TextBlock Text="Дата" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Дата выезда:" Style="{StaticResource FieldLabel}"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding Date}" Margin="0" Padding="6,4"
                                MinHeight="36" FontSize="13"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Дежурный караул:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding SquadNumber, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,10" MinHeight="38" FontSize="14" VerticalContentAlignment="Center" Margin="0"/>
                </Grid>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="ФИО водителя:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding DriverNames}"
                              SelectedItem="{Binding DriverName}"
                              Text="{Binding DriverName, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                              IsEditable="True" Margin="0" Padding="12,10" MaxDropDownHeight="200"
                              FontSize="14" MinHeight="38" VerticalContentAlignment="Center"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                </Grid>

                <TextBlock Text="Работа" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="№ путевого листа:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding TripSheetNumber, UpdateSourceTrigger=PropertyChanged}"
                             Padding="12,10" MinHeight="38" FontSize="14" VerticalContentAlignment="Center" Margin="0"/>
                </Grid>

                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Наименование:" Style="{StaticResource FieldLabel}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding WorkDescriptions}"
                              SelectedItem="{Binding WorkDescription}"
                              Text="{Binding WorkDescription, UpdateSourceTrigger=LostFocus, Mode=TwoWay}"
                              IsEditable="True" Margin="0" Padding="12,10" MaxDropDownHeight="250"
                              FontSize="14" MinHeight="38" VerticalContentAlignment="Center"
                              ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Подробности:" VerticalAlignment="Top"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="13" Margin="0,10,0,0"/>
                    <TextBox Grid.Column="1" Text="{Binding Comments, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" MaxHeight="100"
                             VerticalScrollBarVisibility="Auto" Padding="12,10" FontSize="14" Margin="0"/>
                </Grid>

                <Separator Background="{StaticResource DividerBrush}" Margin="0,6,0,12"/>

                <TextBlock Text="Время выезда и возвращения" Style="{StaticResource SectionTitle}"/>

                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Выезд:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding DepartureTime, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TimeInput}" MaxLength="5" Width="80"
                             PreviewTextInput="TimeInput_PreviewTextInput"/>
                    <TextBlock Grid.Column="2" Text="чч:мм" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0"/>
                </Grid>

                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Возврат:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding ReturnTime, UpdateSourceTrigger=PropertyChanged}"
                             Style="{StaticResource TimeInput}" MaxLength="5" Width="80"
                             PreviewTextInput="TimeInput_PreviewTextInput"/>
                    <TextBlock Grid.Column="2" Text="чч:мм" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="8,0,0,0"/>
                </Grid>

                <Separator Background="{StaticResource DividerBrush}" Margin="0,6,0,12"/>

                <TextBlock Text="Пробег" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Спидометр (км):" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding OdometerBeforeDeparture, Mode=OneWay, Converter={StaticResource DoubleStr}}"
                             Style="{StaticResource ReadOnlyField}" IsReadOnly="True"
                             ToolTip="Вычисляется автоматически"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Пробег (км):" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1"
                             Text="{Binding DistanceKm, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}"
                             Padding="12,10" MinHeight="38" FontSize="14" VerticalContentAlignment="Center" Margin="0"/>
                </Grid>

                <Separator Background="{StaticResource DividerBrush}" Margin="0,6,0,12"/>

                <TextBlock Text="Время работы (мин)" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="С насосом:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding TimeWithPumpMinutes, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}"
                             Padding="12,10" MinHeight="38" FontSize="14" VerticalContentAlignment="Center" Margin="0"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="На холостом ходу:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding TimeWithoutPumpMinutes, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}"
                             Padding="12,10" MinHeight="38" FontSize="14" VerticalContentAlignment="Center" Margin="0"/>
                </Grid>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Смена караула:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding ShiftChangeMinutes, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}"
                             Padding="12,10" MinHeight="38" FontSize="14" VerticalContentAlignment="Center" Margin="0"/>
                </Grid>
                <Grid Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Прочие работы:" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding MiscWorkMinutes, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}"
                             Padding="12,10" MinHeight="38" FontSize="14" VerticalContentAlignment="Center" Margin="0"/>
                </Grid>

                <Separator Background="{StaticResource DividerBrush}" Margin="0,6,0,12"/>

                <TextBlock Text="Топливо" Style="{StaticResource SectionTitle}"/>
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Заправка (л):" Style="{StaticResource FieldLabel}"/>
                    <TextBox Grid.Column="1" Text="{Binding FuelRefueled, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}"
                             Padding="12,10" MinHeight="38" FontSize="14" VerticalContentAlignment="Center" Margin="0"/>
                </Grid>
                <Border Style="{StaticResource InfoBanner}" Padding="14,10" Margin="0,0,0,12">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="Расход по норме: " FontWeight="SemiBold"
                                   Foreground="{StaticResource PrimaryBrush}" FontSize="13"/>
                        <TextBlock Text="{Binding NormConsumption, Mode=OneWay, StringFormat=F3}"
                                   FontWeight="Bold" FontSize="14"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                        <TextBlock Text=" л" Foreground="{StaticResource PrimaryBrush}" FontSize="13"/>
                    </StackPanel>
                </Border>

                <Grid Margin="0,4,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" VerticalAlignment="Center"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                               Text="Изменения внесены"/>
                    <Button Grid.Column="1" Content="Отмена" Command="{Binding CancelCommand}" MinWidth="100" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Grid.Column="2" Content="Сохранить" MinWidth="120"
                            Style="{StaticResource PrimaryButton}" Click="SaveButton_Click" Padding="20,10"
                            FontSize="14" FontWeight="SemiBold"/>
                </Grid>
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
