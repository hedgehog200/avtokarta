<UserControl x:Class="AVTOKarta.Views.NormativeDataView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:converters="clr-namespace:AVTOKarta.Converters"
             xml:lang="ru-RU">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>

    <DockPanel>
        <!-- ============ HEADER ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource CardBorderShadow}" Margin="16,12,16,10" Padding="20,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Width="42" Height="42" CornerRadius="12"
                        Background="{StaticResource PrimaryLightBrush}" Margin="0,0,14,0"
                        VerticalAlignment="Center">
                    <TextBlock Text="&#xF02D;" FontFamily="{StaticResource FontAwesomeSolid}" FontSize="20"
                               Foreground="{StaticResource PrimaryBrush}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock Text="Нормативные данные" FontSize="18" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock Text="Базовые нормы расхода топлива для авто и шасси, используемых в структуре МЧС"
                               FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ============ UNITS LEGEND ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource InfoBanner}" Margin="16,0,16,10" Padding="16,12">
            <StackPanel>
                <TextBlock Text="Что означают цифры" FontSize="13" FontWeight="SemiBold"
                           Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,6"/>
                <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}">
                    <Run FontWeight="Bold" Text="Норма на пробег, л/100 км — " />
                    <Run Text="базовая (линейная) норма расхода на 100 км пробега (в ПО норма вводится в л/км, т.е. значение ÷ 100)." /><LineBreak/>
                    <Run FontWeight="Bold" Text="Насос (спец. агрегат), л/мин — " />
                    <Run Text="расход при работе двигателя с пожарным насосом / спец. агрегатом." /><LineBreak/>
                    <Run FontWeight="Bold" Text="Стационар. режим без нагрузки, л/мин — " />
                    <Run Text="работа двигателя на месте без нагрузки (прогрев/холостой ход)." /><LineBreak/>
                    <Run FontWeight="Bold" Text="Топливо — " />
                    <Run Text="вид топлива; «—» означает, что в источнике он не указан (уточняется по РЭ/паспорту ТС)." /><LineBreak/>
                    <Run FontWeight="Bold" Text="«—»" />
                    <Run Text=" — норма источником не установлена (не задана). Например, если при работе агрегата продолжает работать счётчик спидометра, норма л/мин не устанавливается — расход считается по пробегу."/>
                </TextBlock>
                <TextBlock Text="Источник: распоряжение Минтранса России от 14.03.2008 № АМ-23-р (ред. от 30.09.2021), приложение II, пп. 15.12, 15.12.1, 15.12.2 «Автомобили пожарные»."
                           FontSize="11" Foreground="{StaticResource TextTertiaryBrush}" TextWrapping="Wrap" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>

        <!-- ============ FILTERS ============ -->
        <Border DockPanel.Dock="Top" Style="{StaticResource FieldCard}" Margin="16,0,16,10" Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="Раздел:" Style="{StaticResource FormLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <ComboBox Grid.Column="1" ItemsSource="{Binding NormativeDataVm.Categories}"
                          SelectedItem="{Binding NormativeDataVm.SelectedCategory}"
                          MinWidth="220" HorizontalAlignment="Left"
                          ItemContainerStyle="{StaticResource ComboBoxItemStyle}"/>

                <TextBlock Grid.Column="3" Text="Поиск:" Style="{StaticResource FormLabel}"
                           VerticalAlignment="Center" Margin="0,0,8,0"/>
                <TextBox Grid.Column="4" Text="{Binding NormativeDataVm.SearchText, UpdateSourceTrigger=PropertyChanged}"
                         Style="{StaticResource FormControlTextBox}"
                         ToolTip="Модель ПА, шасси или примечание (например: ЗИЛ-131, КамАЗ-4310, АЦ-40)"/>

                <TextBlock Grid.Column="5" Text="{Binding NormativeDataVm.CountText}" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Center" Margin="12,0,0,0"/>
            </Grid>
        </Border>

        <!-- ============ TABLE ============ -->
        <Border Style="{StaticResource FieldCard}" Margin="16,0,16,12" Padding="0">
            <DataGrid ItemsSource="{Binding NormativeDataVm.Items}"
                      SelectedItem="{Binding NormativeDataVm.SelectedItem}"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      CanUserResizeRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                      BorderThickness="0"
                      FontSize="13"
                      RowHeight="30"
                      EnableRowVirtualization="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Раздел" Binding="{Binding Category}" Width="170"/>
                    <DataGridTextColumn Header="Модель / тип ПА" Binding="{Binding Model}" Width="270"/>
                    <DataGridTextColumn Header="Базовое шасси / двигатель" Binding="{Binding Chassis}" Width="200"/>
                    <DataGridTextColumn Header="Топливо" Binding="{Binding FuelDisplay}" Width="80"/>

                    <DataGridTextColumn Header="Норма на пробег, л/100 км"
                                        Binding="{Binding ConsumptionDisplay}" Width="150">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="ToolTip"
                                        Value="Базовая (линейная) норма расхода на 100 км пробега"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Насос (спец. агрегат), л/мин"
                                        Binding="{Binding PumpDisplay}" Width="170">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="ToolTip"
                                        Value="Расход при работе двигателя со специальным агрегатом (насосом), л/мин"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Стационарный режим без нагрузки, л/мин"
                                        Binding="{Binding IdleDisplay}" Width="210">
                        <DataGridTextColumn.ElementStyle>
                            <Style TargetType="TextBlock">
                                <Setter Property="HorizontalAlignment" Value="Right"/>
                                <Setter Property="ToolTip"
                                        Value="Расход при работе двигателя в стационарном режиме без нагрузки (холостой ход/прогрев), л/мин"/>
                            </Style>
                        </DataGridTextColumn.ElementStyle>
                    </DataGridTextColumn>

                    <DataGridTextColumn Header="Примечание" Binding="{Binding Note}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>
    </DockPanel>
</UserControl>
