<Window x:Class="AVTOKarta.Views.SquadEditView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hc="https://handyorg.github.io/handycontrol"
             xmlns:conv="clr-namespace:AVTOKarta.Converters"
             xmlns:helpers="clr-namespace:AVTOKarta.Helpers"
             Title="Редактирование части" Height="760" Width="640"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <conv:DoubleStringConverter x:Key="DoubleStr"/>
    </Window.Resources>
    <Border Background="White">
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="Hand">
                <DockPanel>
                    <TextBlock Text="Данные части" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button Style="{StaticResource ModalCloseButton}"
                            Click="CloseBtn_Click"/>
                </DockPanel>
            </Border>

            <!-- Buttons -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Click="CancelButton_Click" MinWidth="100" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="Сохранить" MinWidth="100"
                            Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20">
                <StackPanel>
                    <TextBlock Text="Наименование части:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Номер части:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Number, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Номер отряда:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding CrewNumber, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Область / регион:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Region, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="ФИО начальника части:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding ChiefName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="ФИО старшего водителя:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding SeniorDriverName, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,12"/>

                    <TextBlock Text="Контактный телефон:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                             helpers:PhoneHelper.EnablePhoneFormat="True" MaxLength="18" Margin="0,0,0,12"/>

                    <TextBlock Text="Адрес расположения:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding Address, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,16"/>

                    <Border Background="{StaticResource PrimaryLightBrush}" CornerRadius="8" Padding="14,10" Margin="0,0,0,14">
                        <TextBlock Text="Надбавки к нормам расхода ГСМ" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource PrimaryBrush}"/>
                    </Border>

                    <TextBlock Text="Зимняя надбавка (%):" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <TextBox Text="{Binding WinterSurchargePercent, UpdateSourceTrigger=LostFocus, Converter={StaticResource DoubleStr}}"
                             Margin="0,0,0,10"/>

                    <TextBlock Text="Месяцы действия зимней надбавки:" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <ItemsControl ItemsSource="{Binding WinterMonthOptions}" Margin="0,0,0,14">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <ToggleButton Content="{Binding Name}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Style="{StaticResource ToggleSwitchStyle}"
                                              Margin="0,0,12,4" FontSize="12"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Справочник надбавок (название, %, применение):" FontWeight="SemiBold" FontSize="13"
                               Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                    <DataGrid ItemsSource="{Binding FuelSurcharges}"
                              SelectedItem="{Binding SelectedSurcharge, Mode=TwoWay}"
                              AutoGenerateColumns="False"
                              CanUserAddRows="False"
                              IsReadOnly="False"
                              HeadersVisibility="Column"
                              FontSize="12"
                              MinHeight="180" MaxHeight="240"
                              Margin="0,0,0,6">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Название" Binding="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Width="*"/>
                            <DataGridTextColumn Header="%" Binding="{Binding Percent, StringFormat=F2}" Width="60"/>
                            <DataGridTemplateColumn Header="Пробег" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><ToggleButton IsChecked="{Binding AppliesToDistance, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Насос" Width="70">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate><ToggleButton IsChecked="{Binding AppliesToPump, Mode=TwoWay}" Style="{StaticResource ToggleSwitchStyle}"/></DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Content="Добавить" Command="{Binding AddSurchargeCommand}" MinWidth="90" Margin="0,0,8,0"
                                Style="{StaticResource GhostButton}" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <Button Content="Удалить" Command="{Binding RemoveSurchargeCommand}" MinWidth="90"
                                Style="{StaticResource GhostButton}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    </StackPanel>

                    <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                               FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
