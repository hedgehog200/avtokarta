<UserControl x:Class="AVTOKarta.Views.DriverListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:AVTOKarta.Converters"
             xmlns:helpers="clr-namespace:AVTOKarta.Helpers"
             xml:lang="ru-RU">
    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="16,12,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" MinWidth="250"/>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- LEFT: DRIVER LIST -->
        <Border Grid.Column="0" Style="{StaticResource CardBorderShadow}" Padding="0" ClipToBounds="True">
            <DockPanel>
                <!-- Header -->
                <Border DockPanel.Dock="Top" Padding="16,14,16,10"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <Grid VerticalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Водители" FontSize="15" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                        <Button Grid.Column="1" Content="&#x270E;" Style="{StaticResource IconButton}"
                                Command="{Binding EditDriverCommand}" FontSize="13" Padding="5"
                                Foreground="{StaticResource PrimaryBrush}" Margin="0,0,4,0"
                                VerticalAlignment="Center" ToolTip="Редактировать"/>
                        <Button Grid.Column="2" Content="+" Style="{StaticResource SuccessButton}"
                                Command="{Binding AddDriverCommand}" Padding="7,4" FontSize="14"
                                VerticalAlignment="Center" ToolTip="Добавить водителя"/>
                    </Grid>
                </Border>

                <!-- Edit form (inline) -->
                <Border DockPanel.Dock="Top" Visibility="{Binding IsEditing, Converter={StaticResource BoolToVis}}"
                        Background="{StaticResource PrimaryLightBrush}" Padding="14,12">
                    <StackPanel>
                        <TextBlock Text="ФИО" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" MinHeight="28" FontSize="12"/>
                        <TextBlock Text="Телефон" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding Phone, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" MinHeight="28" FontSize="12"
                                 helpers:PhoneHelper.EnablePhoneFormat="True" MaxLength="18"/>
                        <TextBlock Text="Категория прав" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <TextBox Text="{Binding LicenseCategory, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" MinHeight="28" FontSize="12"/>
                        <TextBlock Text="Дата приёма" FontSize="10" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,2"/>
                        <DatePicker SelectedDate="{Binding HireDate}" Margin="0,0,0,10" FontSize="11"/>
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}" FontSize="10" Margin="0,0,0,6"/>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Content="Отмена" Command="{Binding CancelCommand}" Padding="12,5" FontSize="11" Margin="0,0,6,0"
                                    Style="{StaticResource DangerButton}"/>
                            <Button Content="Сохранить" Command="{Binding ConfirmCommand}"
                                    Style="{StaticResource SuccessButton}" Padding="12,5" FontSize="11"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Footer: count -->
                <Border DockPanel.Dock="Bottom" Padding="14,8"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0">
                    <TextBlock Text="{Binding Drivers.Count, StringFormat='Всего: {0}'}"
                               FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                               HorizontalAlignment="Right" VerticalAlignment="Center"/>
                </Border>

                <!-- Driver items -->
                <ListBox x:Name="DriverListBox" ItemsSource="{Binding Drivers}"
                         SelectedItem="{Binding FilterDriver}"
                         BorderThickness="0" Background="Transparent"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         MinHeight="100">
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                            <Setter Property="Padding" Value="0"/>
                            <Setter Property="Margin" Value="0"/>
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Border x:Name="Bd" Background="Transparent"
                                                BorderBrush="{StaticResource DividerBrush}"
                                                BorderThickness="0,0,0,1">
                                            <ContentPresenter/>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource ComboBoxSelectedBrush}"/>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Border Padding="14,10" BorderBrush="{StaticResource DividerBrush}"
                                    BorderThickness="0,0,0,1" Background="Transparent">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                        <TextBlock Text="{Binding FullName}" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource TextPrimaryBrush}"/>
                                        <TextBlock Text="{Binding Phone}" FontSize="11"
                                                   Foreground="{StaticResource TextSecondaryBrush}" Margin="0,3,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Категория:" Margin="0,0,4,0"/>
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding LicenseCategory}"/>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                            <TextBlock FontSize="11" Foreground="{StaticResource TextSecondaryBrush}"
                                                       Text="Дата приёма:" Margin="0,0,4,0"/>
                                            <TextBlock FontSize="11" FontWeight="SemiBold"
                                                       Foreground="{StaticResource TextPrimaryBrush}"
                                                       Text="{Binding HireDate, StringFormat=dd.MM.yyyy}"/>
                                        </StackPanel>
                                    </StackPanel>
                                    <Button Grid.Column="1" Content="&#x2716;"
                                            Style="{StaticResource IconButton}" FontSize="11" Padding="6,4"
                                            Foreground="{StaticResource DangerBrush}"
                                            VerticalAlignment="Center" ToolTip="Удалить"
                                            Command="{Binding DataContext.DeleteSelectedDriverCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </DockPanel>
        </Border>

        <!-- GRID SPLITTER -->
        <GridSplitter Grid.Column="1" Width="4" HorizontalAlignment="Center" VerticalAlignment="Stretch"
                      Background="Transparent" ResizeBehavior="CurrentAndNext" Cursor="SizeWE"/>

        <!-- RIGHT: TRIP HISTORY -->
        <Border Grid.Column="2" Style="{StaticResource CardBorderShadow}" Padding="0" ClipToBounds="True">
            <DockPanel>
                <!-- Filter bar -->
                <Border DockPanel.Dock="Top" Padding="16,12,16,10"
                        BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,0,0,1">
                    <StackPanel>
                        <!-- Row 1: title + filter mode + date -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                                <Border Background="{StaticResource PrimaryBrush}" CornerRadius="6"
                                        Width="8" Height="8" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                <TextBlock Text="История поездок" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                <TextBlock Text="Режим:" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding FilterModes}"
                                          SelectedItem="{Binding FilterMode}"
                                          Width="170" Padding="6,4" FontSize="12">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock>
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Все"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding}" Value="ByDriver">
                                                                <Setter Property="Text" Value="По водителю"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="ByDate">
                                                                <Setter Property="Text" Value="По дате"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding}" Value="ByDriverAndDate">
                                                                <Setter Property="Text" Value="Водитель + дата"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0"
                                        Visibility="{Binding IsDateFilterActive, Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="Дата:" VerticalAlignment="Center" Margin="0,0,6,0"
                                           Foreground="{StaticResource TextSecondaryBrush}" FontSize="12"/>
                                <DatePicker SelectedDate="{Binding SelectedDate}" Width="150"
                                            Padding="4,2" VerticalAlignment="Center"/>
                            </StackPanel>
                            <Button Grid.Column="3" Content="Сбросить фильтр" Command="{Binding ClearFilterCommand}"
                                    Padding="10,4" FontSize="11" HorizontalAlignment="Right"
                                    Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVis}}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Active filter description -->
                <Border DockPanel.Dock="Top" Padding="16,6,16,10"
                        Visibility="{Binding IsFilterActive, Converter={StaticResource BoolToVis}}">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock FontSize="12" VerticalAlignment="Center">
                            <Run Text="Фильтр: " Foreground="{StaticResource TextSecondaryBrush}"/>
                            <Run Text="{Binding FilterDescription, Mode=OneWay}" FontWeight="SemiBold" Foreground="{StaticResource PrimaryBrush}"/>
                            <Run Text="  —  " Foreground="{StaticResource TextTertiaryBrush}"/>
                            <Run Text="{Binding TripCount, Mode=OneWay}" FontWeight="Bold"/>
                            <Run Text=" записей" Foreground="{StaticResource TextSecondaryBrush}"/>
                        </TextBlock>
                    </StackPanel>
                </Border>

                <!-- Trip table -->
                <DataGrid ItemsSource="{Binding TripHistory}"
                          Margin="12,8,12,12" FontSize="12"
                          EnableRowVirtualization="True"
                          VirtualizingPanel.IsVirtualizing="True"
                          VirtualizingPanel.VirtualizationMode="Recycling"
                          VirtualizingPanel.ScrollUnit="Pixel"
                          ScrollViewer.CanContentScroll="True"
                          CanUserResizeRows="True"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          BorderThickness="0"
                          GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="{StaticResource DividerBrush}"
                          HeadersVisibility="Column"
                          RowBackground="White"
                          AlternatingRowBackground="{StaticResource SurfaceBrush}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Дата" Binding="{Binding DateDisplay}" Width="90"/>
                        <DataGridTextColumn Header="Водитель" Binding="{Binding DriverName}" Width="140"/>
                        <DataGridTextColumn Header="Автомобиль" Binding="{Binding VehicleDisplay}" Width="160"/>
                        <DataGridTextColumn Header="Место работы" Binding="{Binding WorkDescription}" Width="*"/>
                        <DataGridTextColumn Header="Выезд" Binding="{Binding DepartureTime}" Width="55"/>
                        <DataGridTextColumn Header="Возврат" Binding="{Binding ReturnTime}" Width="55"/>
                        <DataGridTextColumn Header="Пробег, км" Binding="{Binding DistanceKm, StringFormat=N1}" Width="80"/>
                        <DataGridTextColumn Header="Расход, л" Binding="{Binding ActualConsumption, StringFormat=F3}" Width="80"/>
                        <DataGridTextColumn Header="Караул" Binding="{Binding SquadNumber}" Width="65"/>
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
