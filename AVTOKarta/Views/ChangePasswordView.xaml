<Window x:Class="AVTOKarta.Views.ChangePasswordView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:hc="https://handyorg.github.io/handycontrol"
        Title="Смена пароля" Height="340" Width="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="False"
        Background="{StaticResource BackgroundBrush}">
    <Border Background="White">
        <DockPanel>
            <!-- Header -->
            <Border DockPanel.Dock="Top" Background="{StaticResource PrimaryBrush}" Padding="20,14"
                    MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="Hand">
                <DockPanel>
                    <TextBlock Text="Смена пароля" FontSize="16" FontWeight="Bold"
                               Foreground="White" VerticalAlignment="Center"/>
                    <Button Content="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="12"
                            HorizontalAlignment="Right" Background="Transparent" Foreground="White"
                            BorderThickness="0" Cursor="Hand" Click="CloseBtn_Click" Width="32" Height="32"/>
                </DockPanel>
            </Border>

            <!-- Buttons -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource DividerBrush}" BorderThickness="0,1,0,0" Padding="16,12">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Отмена" Click="CancelButton_Click" MinWidth="100" Margin="0,0,8,0"
                            Style="{StaticResource GhostButton}" Foreground="{StaticResource TextSecondaryBrush}"/>
                    <Button Content="Сменить" Command="{Binding ConfirmCommand}" MinWidth="100"
                            Style="{StaticResource PrimaryButton}" Click="SaveButton_Click"/>
                </StackPanel>
            </Border>

            <!-- Content -->
            <StackPanel Margin="24,20">
                <TextBlock Text="Текущий пароль:" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <hc:PasswordBox x:Name="OldPasswordBox" Margin="0,0,0,14" Height="36"/>

                <TextBlock Text="Новый пароль:" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <hc:PasswordBox x:Name="NewPasswordBox" Margin="0,0,0,14" Height="36"/>

                <TextBlock Text="Подтвердите новый пароль:" FontWeight="SemiBold" FontSize="13"
                           Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,6"/>
                <hc:PasswordBox x:Name="ConfirmPasswordBox" Margin="0,0,0,10" Height="36"/>

                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource DangerBrush}"
                           FontWeight="SemiBold" FontSize="12" TextWrapping="Wrap"/>
            </StackPanel>
        </DockPanel>
    </Border>
</Window>